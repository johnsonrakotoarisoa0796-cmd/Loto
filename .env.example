# Local development only. Never commit real secrets.
APP_PASSWORD=change-this-password
SECRET_KEY=replace-with-a-long-random-secret
# Local SQLite; on Render set DATABASE_URL to the Supabase PostgreSQL URI.
DATABASE_URL=sqlite:///./loto.db
COOKIE_SECURE=false

# Official draw start time (Madagascar local wall-clock time).
DRAW_TIME=16:35
DRAW_TIMEZONE=Indian/Antananarivo
# Provisional Bet261 reference: approximate center of Antaninarenina, Antananarivo.
# Replace these if the actual operator confirms another physical draw site.
DRAW_LOCATION_NAME=Antaninarenina, Antananarivo (approximatif)
DRAW_LOCATION_LAT=-18.9103
DRAW_LOCATION_LON=47.52502
DRAW_LOCATION_IS_ESTIMATE=true
SEISMIC_RADIUS_KM=200
SEISMIC_MIN_MAGNITUDE=2.5
