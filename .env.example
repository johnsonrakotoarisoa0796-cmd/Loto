# Local development only. Never commit real secrets.
APP_PASSWORD=change-this-password
SECRET_KEY=replace-with-a-long-random-secret
# Local SQLite; on Render set DATABASE_URL to the Supabase PostgreSQL URI.
DATABASE_URL=sqlite:///./loto.db
COOKIE_SECURE=false

# Official draw start time (local wall-clock time at draw location).
DRAW_TIME=16:35
# Set the IANA time zone of the actual draw site; "auto" temporarily interprets 16:35 as UTC.
DRAW_TIMEZONE=auto
