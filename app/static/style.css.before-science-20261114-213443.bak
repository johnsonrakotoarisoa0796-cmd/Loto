t-size:10px;line-height:1.55}.text-link{border:0;background:transparent;color:var(--blue);font-size:10px;font-weight:800;padding:5px 0;white-space:nowrap}.text-link span{font-size:14px;margin-left:3px}.icon-button{width:32px;height:32px;border:1px solid var(--line);background:#fff;border-radius:9px;color:#77839a;font-size:17px;display:grid;place-items:center}.icon-button:hover{color:var(--blue);border-color:#cbd1ff}.bar-list{display:grid;gap:11px;padding:7px 0 12px}.bar-row{display:grid;grid-template-columns:34px 1fr 29px;align-items:center;gap:10px}.bar-number{width:27px;height:27px;border-radius:9px;background:#eef0ff;color:#5b67df;display:grid;place-items:center;font:11px 'DM Mono',monospace;font-weight:500}.bar-track{height:8px;border-radius:20px;background:#f0f2f6;overflow:hidden}.bar-fill{height:100%;border-radius:20px;background:linear-gradient(90deg,#626fea,#8e99ff)}.bar-count{font:10px 'DM Mono',monospace;color:#7f899b;text-align:right}.chart-legend{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #f0f2f5;padding-top:11px;color:#9aa2b1;font-size:9px}.legend-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px}.legend-dot.blue{background:#6875ed}.recent-list{display:grid}.recent-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f0f2f5;gap:10px}.recent-row:last-child{border-bottom:0}.recent-date{font-size:10px;color:#637086;font-weight:700;min-width:73px}.ball-row{display:flex;gap:5px;flex-wrap:wrap}.ball{width:26px;height:26px;border-radius:50%;display:inline-grid;place-items:center;background:#f0f2ff;color:#5363dd;font:10px 'DM Mono',monospace;font-weight:500;border:1px solid #e2e6ff}.ball.small{width:23px;height:23px;font-size:9px}.ball.shared{background:#fff0df;color:#bb7637;border-color:#f5dfc6}.repeat-summary{display:flex;align-items:center;gap:25px;padding:7px 0 17px}.repeat-summary>div:first-child{min-width:110px}.repeat-summary strong{display:block;font-size:31px;letter-spacing:-1px}.repeat-summary span{color:#99a2b1;font-size:9px}.repeat-progress{flex:1}.progress-track{height:8px;background:#f1f2f6;border-radius:20px;overflow:hidden}.progress-track span{display:block;height:100%;width:0;background:linear-gradient(90deg,#eb9d5d,#f5c27a);border-radius:20px;transition:width .4s}.progress-labels{display:flex;justify-content:space-between;margin-top:8px;gap:12px}.progress-labels span{font-size:9px;color:#929bad}.repeat-timeline{display:flex;gap:7px;overflow-x:auto;padding:7px 0 3px}.timeline-item{min-width:76px;background:#f8f9fb;border:1px solid #edf0f4;border-radius:10px;padding:9px 8px;text-align:center}.timeline-item .timeline-date{font-size:8px;color:#a0a8b6}.timeline-item strong{display:block;font:13px 'DM Mono',monospace;margin:7px 0 2px;color:#37445b}.timeline-item small{font-size:8px;color:#9aa3b2}.timeline-item.has-repeat{background:#fff8f0;border-color:#fae8d4}.timeline-item.has-repeat strong{color:#be7b3f}.insight-panel{background:linear-gradient(145deg,#182741,#243555);color:#fff;border-color:#243555;position:relative;overflow:hidden}.insight-panel:after{content:"";position:absolute;width:190px;height:190px;border:1px solid #ffffff12;border-radius:50%;right:-60px;top:-75px;box-shadow:0 0 0 23px #ffffff06,0 0 0 46px #ffffff04}.insight-panel .eyebrow{color:#aab5d0}.insight-mark{font-size:24px;color:#a2aaff;margin:8px 0}.insight-panel h2{font-size:18px;max-width:260px;line-height:1.35}.insight-panel p{color:#c1c9d9;font-size:10px;line-height:1.85;max-width:420px}.insight-panel p strong{color:#fff}.insight-panel .text-link{position:relative;z-index:1;color:#aeb5ff;margin-top:5px}.data-note{display:flex;align-items:flex-start;gap:9px;color:#9aa3b2;font-size:9px;line-height:1.7;margin:16px 2px}.data-note>span:first-child{color:#7b88ec;font-size:13px}.data-note code{font:9px 'DM Mono',monospace;background:#e9edf5;padding:2px 4px;border-radius:4px;color:#58657a}.app-footer{display:flex;justify-