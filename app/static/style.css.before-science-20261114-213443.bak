play:block;height:100%;background:#7b86f0;border-radius:12px}.transition-panel{margin-top:16px}.no-repeat{color:#a4adba;font-size:9px}.prediction-banner{border-radius:17px;background:linear-gradient(110deg,#182743,#2d3d66);color:#fff;padding:21px 25px;display:flex;align-items:center;gap:20px;margin-bottom:16px;position:relative;overflow:hidden}.prediction-banner:after{content:"";position:absolute;right:13%;top:-95px;width:260px;height:260px;border:1px solid #ffffff13;border-radius:50%;box-shadow:0 0 0 25px #ffffff07,0 0 0 50px #ffffff04}.prediction-orbit{width:54px;height:54px;border-radius:16px;background:#ffffff15;color:#bbc2ff;display:grid;place-items:center;font-size:27px;flex:none}.prediction-banner .eyebrow{color:#abb8d7}.prediction-banner h2{font-size:22px;letter-spacing:3px;margin:7px 0 4px;font-family:'DM Mono',monospace}.prediction-banner p{font-size:9px;color:#c0c9dc;margin:0}.prediction-method{margin-left:auto;position:relative;z-index:1;padding-left:20px;border-left:1px solid #ffffff20;min-width:170px}.prediction-method span,.prediction-method strong,.prediction-method small{display:block}.prediction-method span{font:8px 'DM Mono',monospace;color:#9eabc9;letter-spacing:1px}.prediction-method strong{font-size:11px;margin:7px 0}.prediction-method small{color:#aab7d0;font-size:9px}.prediction-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:16px}.ranking-list{display:grid;gap:11px}.ranking-row{display:grid;grid-template-columns:25px 27px 1fr 51px;gap:9px;align-items:center}.rank-index{font:9px 'DM Mono',monospace;color:#a5adba}.ranking-row .bar-track{height:7px}.ranking-row .score{font:9px 'DM Mono',monospace;color:#56647a;text-align:right}.alternative-list{display:grid;gap:10px}.alternative-row{border:1px solid #edf0f4;background:#fafbfd;border-radius:11px;padding:12px}.alternative-row>span{font-size:8px;color:#9ca5b3;letter-spacing:1px}.alternative-row .ball-row{margin-top:9px}.model-caveat{margin-top:14px;background:#fff6eb;border:1px solid #f6e8d5;border-radius:10px;padding:11px 12px}.model-caveat strong{font-size:9px;color:#a97036}.model-caveat p{font-size:9px;line-height:1.65;color:#9b805f;margin:4px 0 0}.backtest-panel{margin-top:16px}.backtest-content{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.backtest-metric{background:#f8f9fb;border:1px solid #eef0f4;border-radius:11px;padding:13px}.backtest-metric span{display:block;font-size:8px;color:#929dad}.backtest-metric strong{display:block;font-size:20px;letter-spacing:-.8px;margin-top:7px;color:#34425a}.backtest-message{grid-column:1/-1;background:#f8f9fb;color:#8893a4;padding:15px;border-radius:10px;font-size:10px;line-height:1.65}.modal{border:0;border-radius:18px;padding:0;width:min(500px,calc(100% - 28px));max-width:none;box-shadow:0 25px 100px #0c18355c}.modal::backdrop{background:#101a2b88;backdrop-filter:blur(4px)}.modal-card{padding:24px}.modal-heading{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:21px}.modal-heading .eyebrow{margin:0 0 6px}.modal-heading h2{margin:0;font-size:20px;letter-spacing:-.6px}.field-label{display:block;font-size:10px;font-weight:800;color:#566279;margin:13px 0 7px}.field-label span{font-size:9px;color:#9ca5b4;font-weight:500;margin-left:8px}.modal-card input[type=date],.modal-card input[type=text],.modal-card textarea,.login-form input{width:100%;border:1px solid #e5e9f0;background:#fbfcfd;border-radius:9px;padding:11px 12px;color:#344158;outline:none;font-size:11px}.modal-card input:focus,.modal-card textarea:focus,.login-form input:focus{border-color:#9aa4f4;box-shadow:0 0 0 3px #6c79e51b}.number-input-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.number-input{width:100%;height:47px;border:1px solid #e5e9f0;background:#f7f8fc;border-radius:10px;text-align:center;font:15px 'DM Mono',monospace;color:#5666dc;outline:none}.number-input:focus{border-color:#9aa4f4;background:#fff}.modal-card textarea{resize:vertical}.form-error{color:#c75e52;font-size:10px;min-height:17px;margin-top:7px}.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:10px}.toast{position:fixed;right:24px;bottom:22px;z-index:30;transform:translateY(20px);opacity:0;pointer-events:none;background:#182743;color:#fff;padding:12px 16px;border-radius:11px;box-shadow:0 12px 30px #14223b33;font-size:10px;transition:.25s;max-width:min(420px,calc(100% - 30px))}.toast.show{transform:translateY(0);opacity:1}.toast.error{background:#8f4039}.empty-state{padding:24px;text-align:center;color:#a1a9b6;font-size:10px}.skeleton-line{height:13px;border-radius:7px;background:linear-gradient(90deg,#f0f2f6,#f8f9fb,#f0f2f6);background-size:200% 100%;animation:shine 1.4s infinite}@keyframes shine{to{background-position:-200% 0}}.login-body{min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 20% 20%,#29385b 0,#111d31 45%,#101827 100%);padding:22px}.login-card{background:#fff;width:min(420px,100%);padding:35px;border-radius:22px;box-shadow:0 30px 100px #030a1880}.login-card .brand-mark{margin-bottom:25px}.login-card .eyebrow{color:#8b95a7}.login-card h1{font-size:30px;line-height:1.2;letter-spacing:-1.4px;margin:10px 0}.login-card .muted{color:#8994a6;font-size:11px;line-height:1.7}.login-form{margin:24px 0 18px}.login-form label{display:block;font-size:10px;font-weight:800;color:#5e6a80;margin-bottom:7px}.tiny{font-size:9px!important}.alert{padding:10px 12px;border-radius:8px;font-size:10px;margin:14px 0}.alert-error{background:#fff0ed;color:#bb5c50;border:1px solid #f8d9d2}
@media(max-width:1150px){.main-area{padding:0 23px 22px}.sidebar{width:218px}.main-area{margin-left:218px}.stat-grid{grid-template-columns:repeat(2,1fr)}.overview-grid,.lower-grid{grid-template-columns:1fr 1fr}.analysis-grid{grid-template-columns:1fr 1fr}}
@media(max-width:800px){.sidebar{width:72px;padding:20px 10px}.brand{padding:0 7px 27px}.brand>span:last-child,.side-label,.nav-item:not(.active) .nav-count,.nav-item{font-size:0}.nav-item{justify-content:center;padding:13px 8px}.nav-icon{font-size:18px}.nav-count{display:none}.nav-item.active{font-size:0}.sidebar-note{justify-content:center;padding:12px 5px}.sidebar-note>div,.logout-btn,.version{display:none}.main-area{margin-left:72px;padding:0 18px 18px}.topbar{height:62px}.sync-status{display:none}.page-heading h1{font-size:26px}.overview-grid,.lower-grid,.analysis-grid,.prediction-grid{grid-template-columns:1fr}.wide-panel{grid-row:auto}.prediction-banner{flex-wrap:wrap}.prediction-method{margin-left:74px;border-left:0;padding-left:0}.heading-actions{justify-content:flex-end}}
@media(max-width:560px){.sidebar{position:fixed;inset:auto 0 0;width:100%;height:66px;padding:7px 10px;background:#111d31;flex-direction:row;justify-content:center;box-shadow:0 -5px 18px #14223b22}.brand,.side-label,.sidebar-bottom{display:none}.side-nav{width:100%;display:flex;justify-content:space-around;gap:4px}.nav-item,.nav-item.active{display:grid;gap:3px;justify-items:center;align-content:center;width:25%;padding:5px 2px;font-size:8px;border-radius:9px}.nav-icon{font-size:17px;line-height:1}.main-area{margin-left:0;padding:0 13px 85px}.topbar{height:58px}.crumb{font-size:9px}.top-actions .btn{font-size:9px;padding:8px 9px}.page{padding-top:24px}.page-heading{align-items:flex-start;flex-direction:column;margin-bottom:18px}.page-heading h1{font-size:25px}.subheading{font-size:10px;line-height:1.5}.heading-date{display:none}.stat-grid{gap:9px}.stat-card{padding:13px;min-height:112px}.stat-top{font-size:9px}.stat-value{font-size:24px}.date-value{font-size:18px}.stat-foot{font-size:8px}.panel{padding:15px}.panel h2{font-size:14px}.recent-row{flex-wrap:wrap}.repeat-summary{gap:12px}.repeat-summary>div:first-child{min-width:80px}.repeat-summary strong{font-size:26px}.progress-labels{flex-direction:column;gap:3px}.app-footer{font-size:7px;gap:10px;line-height:1.6}.table-toolbar{align-items:flex-start;flex-direction:column}.search-box,.search-box input{width:100%}.heading-actions{width:100%;justify-content:flex-start;gap:7px}.heading-actions .btn{padding:8px 9px;font-size:9px}.analysis-grid{gap:10px}.heat-grid{gap:5px}.heat-cell{padding:8px 2px 6px}.prediction-banner{padding:17px;gap:12px}.prediction-orbit{width:42px;height:42px}.prediction-banner h2{font-size:18px;letter-spacing:1.5px}.prediction-method{margin-left:54px}.backtest-content{grid-template-columns:1fr}.backtest-message{grid-column:auto}.modal-card{padding:19px}.toast{right:14px;bottom:80px}.table-footer{flex-direction:column;gap:5px}}
.prediction-banner h2 span{display:inline-block;color:#fff;min-width:26px;text-align:center}
.prediction-method .btn{margin-top:10px;font-size:9px;padding:7px 9px}.prediction-history-panel{margin-top:16px}.prediction-history-panel td small{color:#9ba4b3;font-size:8px}
.heat-cell span{font-size:7px;white-space:nowrap}
