:root{--bg:#f4f6fa;--paper:#fff;--ink:#182234;--muted:#778196;--line:#e8ecf2;--navy:#111d31;--navy2:#1a2942;--blue:#5967e8;--blue2:#7784ff;--cyan:#39b6c5;--orange:#ef9a55;--green:#33a88a;--purple:#9875e8;--shadow:0 12px 34px rgba(29,42,68,.055);--radius:17px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Manrope,Inter,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:14px}button,input,textarea{font:inherit}button{cursor:pointer}.app-shell{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:248px;background:var(--navy);color:#f4f6ff;padding:26px 18px 20px;display:flex;flex-direction:column;z-index:10}.brand{display:flex;gap:12px;align-items:center;color:#fff;text-decoration:none;padding:0 10px 36px}.brand-mark{width:48px;height:48px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(145deg,#7580ff,#515fe0);color:#fff;font-weight:800;font-size:18px;letter-spacing:-1px;box-shadow:0 8px 22px #5363e555}.brand-mark.small{width:38px;height:38px;border-radius:12px;font-size:14px}.brand strong{display:block;font-size:18px;letter-spacing:-.8px}.brand-accent{color:#8792ff}.brand small{display:block;color:#8693ad;font-size:9px;letter-spacing:2px;margin-top:2px}.side-label,.eyebrow{font-size:9px;font-weight:800;letter-spacing:1.7px;color:#909bb0}.side-label{padding:0 12px 13px}.side-nav{display:grid;gap:7px}.nav-item{border:0;background:transparent;color:#aab5ca;width:100%;display:flex;align-items:center;gap:12px;padding:12px 13px;border-radius:11px;text-align:left;font-size:12px;font-weight:700;transition:.18s}.nav-item:hover{background:#ffffff0b;color:#fff}.nav-item.active{background:linear-gradient(100deg,#5968e8,#6674f0);color:#fff;box-shadow:0 8px 18px #485be044}.nav-icon{width:19px;text-align:center;font-size:18px;font-weight:400}.nav-count{margin-left:auto;border-radius:20px;background:#ffffff18;padding:3px 7px;font:10px 'DM Mono',monospace}.sidebar-bottom{margin-top:auto}.sidebar-note{padding:13px 11px;display:flex;gap:10px;align-items:center;border:1px solid #ffffff12;background:#ffffff08;border-radius:12px;margin-bottom:14px}.note-dot,.status-dot{width:7px;height:7px;background:#52c49d;border-radius:50%;box-shadow:0 0 0 4px #52c49d1c;flex:none}.sidebar-note strong,.sidebar-note small{display:block}.sidebar-note strong{font-size:10px}.sidebar-note small{font-size:9px;color:#8e9ab1;margin-top:3px}.logout-btn{border:0;background:transparent;color:#94a0b7;font-size:11px;padding:9px 11px}.logout-btn:hover{color:#fff}.version{color:#67758f;font:9px 'DM Mono',monospace;letter-spacing:1px;padding:12px 11px}.version span{color:#a0a9bc}.main-area{margin-left:248px;min-height:100vh;padding:0 34px 22px;max-width:1800px}.topbar{height:72px;border-bottom:1px solid #e7ebf1;display:flex;align-items:center;justify-content:space-between}.crumb{font-size:11px;color:#9aa3b3}.crumb strong{color:#344056;font-weight:700}.crumb i{font-style:normal;margin:0 8px;color:#c3c9d3}.top-actions,.heading-actions{display:flex;align-items:center;gap:10px}.sync-status{display:flex;align-items:center;gap:8px;color:#7a879b;font-size:10px;margin-right:10px}.btn{border:1px solid transparent;border-radius:10px;padding:10px 14px;display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:800;font-size:11px;text-decoration:none;transition:.18s;white-space:nowrap}.btn-primary{background:var(--blue);color:white;box-shadow:0 7px 16px #5967e82b}.btn-primary:hover{background:#4858d4;transform:translateY(-1px)}.btn-secondary{background:#fff;color:#59657b;border-color:#e3e8f0}.btn-secondary:hover{border-color:#bfc9da;color:var(--blue)}.btn-sm{padding:9px 12px}.btn-wide{width:100%;margin-top:9px;padding:13px}.plus{font-size:16px;font-weight:400}.page{display:none;padding-top:34px;animation:fade .22s ease}.page.active{display:block}@keyframes fade{from{opacity:.3;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}.page-heading{display